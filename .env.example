# Terravado internal portal — environment
# Copy to .env.local and fill in. WITHOUT the Supabase vars set, the app runs in
# local-first dev mode (in-memory data, auth bypassed) so you can work without
# Supabase. The integration vars below are all optional — each integration has a
# working fallback and switches on only when its variable is set. See the
# Integrations page in the portal for the live status of each.

# --- Core (required for the real, persisted app) ---
# Supabase — Project Settings → API. A separate account for Terravado keeps it
# apart from TGS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth is configured inside Supabase (Authentication → Providers →
# Google), not here. See README for the redirect URL to register with Google.

# --- Integrations (all optional; each has a fallback until set) ---

# Serviceability / finance — Quickli. Fallback: manual lender products + engine.
# Needs a Quickli partnership + API agreement (no public API).
QUICKLI_API_KEY=

# Property data — CoreLogic. Fallback: built-in indicative stub. Query-live under
# a commercial licence (data not stored).
CORELOGIC_API_KEY=

# Listings / property supply — Domain. Fallback: manual property entry. Needs a
# Domain API agreement (no resale, onshore hosting).
DOMAIN_API_KEY=

# Geography / imagery — Google Maps (Static Maps + Street View on the property
# record). Fallback: a plain "view on Google Maps" link. Needs a Google Cloud
# project with billing enabled (free monthly tier); restrict the key by HTTP
# referrer and to the Static Maps + Street View Static APIs. Client-visible key.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Lender product data — CDR Open Banking. Fallback: manually-entered rates/fees.
# Public CDR Product APIs (no paid key); set to "true" once the poller is built.
CDR_PRODUCTS_ENABLED=

# Client bank data — Open Banking CONSUMER data (income/expense/liability
# verification into the Financials record). Fallback: client-supplied statements.
# Via an accredited intermediary (frollo|basiq|illion), representative model.
# Build on sandbox first (BANK_DATA_MODE=sandbox, no accreditation); live needs
# the representative arrangement. Leave blank to stay on the fallback.
BANK_DATA_PROVIDER=
BANK_DATA_MODE=sandbox

# Lodgement — Simpology (LIXI-native, Connect/SSI). Fallback: export handoff via
# the broker's own aggregator channel. Needs a partnership + production licence.
SIMPOLOGY_API_KEY=

# Lodgement — NextGen (ApplyOnline, 60+ lenders). Fallback: export handoff. Needs
# a partnership + production licence.
NEXTGEN_API_KEY=
